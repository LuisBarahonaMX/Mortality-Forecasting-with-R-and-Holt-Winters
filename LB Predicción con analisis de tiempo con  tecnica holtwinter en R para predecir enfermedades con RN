 del modelo Holt–Winters:\n","Holt-Winters exponential smoothing without trend and without seasonal component.\n","\n","Call:\n","HoltWinters(x = ts_enf, beta = FALSE, gamma = FALSE)\n","\n","Smoothing parameters:\n"," alpha: 0.5872962\n"," beta : FALSE\n"," gamma: FALSE\n","\n","Coefficients:\n","       [,1]\n","a 0.2425227\n","Predicción para 2024:\n","Time Series:\n","Start = 2024 \n","End = 2024 \n","Frequency = 1 \n","      fit \n","0.2425227 \n"]},{"output_type":"display_data","data":{"image/png":"\n","text/plain":["<IPython.core.display.Image object>"]},"metadata":{}}]},{"cell_type":"markdown","source":["#❎GRAFICA DE DISPERCION DE LA SERIE DE TIEMPO DEL NUMERO DE ENFERMEDADES"],"metadata":{"id":"YMxMV4ifase0"}},{"cell_type":"code","source":["%%R\n","# Instalar y cargar el paquete scatterplot3d si aún no está instalado\n","if(!require(scatterplot3d)) install.packages(\"scatterplot3d\", repos = \"http://cran.us.r-project.org\")\n","library(scatterplot3d)\n","\n","# Asegurarse de que la columna 'AÑO' es numérica\n","df_agg$`AÑO` <- as.numeric(df_agg$`AÑO`)\n","\n","# Convertir la variable MORTALIDAD en factor y obtener un ID numérico para cada enfermedad\n","df_agg <- df_agg %>%\n","  mutate(EnfermedadID = as.numeric(as.factor(MORTALIDAD)))\n","\n","# Opcional: definir colores para cada enfermedad (según el factor)\n","colores <- rainbow(length(unique(df_agg$MORTALIDAD)))[as.factor(df_agg$MORTALIDAD)]\n","\n","# Crear la gráfica de dispersión 3D\n","scatterplot3d(x = df_agg$`AÑO`,\n","              y = df_agg$Total_Pacientes,\n","              z = df_agg$EnfermedadID,\n","              pch = 19,\n","              color = colores,\n","              xlab = \"AÑO\",\n","              ylab = \"Total de Pacientes\",\n","              zlab = \"Enfermedad (ID)\",\n","              main = \"Gráfica 3D de Dispersión: Serie de Tiempo de Enfermedades\",\n","              xlim = c(2013,2023),\n","              ylim = c(0,150))\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":740},"id":"eIlRP3oHH41F","executionInfo":{"status":"ok","timestamp":1741378362018,"user_tz":300,"elapsed":4022,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"5f1118ad-c520-4102-d6f5-20b6c654739f"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["Loading required package: scatterplot3d\n","Installing package into ‘/usr/local/lib/R/site-library’\n","(as ‘lib’ is unspecified)\n","trying URL 'http://cran.us.r-project.org/src/contrib/scatterplot3d_0.3-44.tar.gz'\n","Content type 'application/x-gzip' length 475696 bytes (464 KB)\n","==================================================\n","downloaded 464 KB\n","\n","\n","The downloaded source packages are in\n","\t‘/tmp/RtmpdqfcVD/downloaded_packages’\n","In addition: Warning message:\n","In library(package, lib.loc = lib.loc, character.only = TRUE, logical.return = TRUE,  :\n","  there is no package called ‘scatterplot3d’\n"]},"metadata":{}},{"output_type":"display_data","data":{"image/png":"\n","text/plain":["<IPython.core.display.Image object>"]},"metadata":{}}]},{"cell_type":"markdown","source":["#⏫<font color=\"GREEN\">**METODO CRISP DM** </font>:⏫\n","##⛔<font color=\"red\">**DESPLIEGUE (RESULTADOS)** </font>:⛔\n"],"metadata":{"id":"dnWGlFKErYnI"}},{"cell_type":"markdown","source":["#⭕⭕ #GENERACIÓN DEL TOP 10 DE ENFERMEDADES DEL 2024 ⭕⭕"],"metadata":{"id":"35mDDnd2b7bc"}},{"cell_type":"code","source":["%%R\n","unique_diseases <- unique(df_agg$MORTALIDAD)\n","\n","# Crear un data frame vacío para guardar las predicciones\n","results <- data.frame(Disease = character(),\n","                      Predicted2024 = numeric(),\n","                      stringsAsFactors = FALSE)\n","\n","# Iterar por cada enfermedad\n","for (d in unique_diseases) {\n","\n","  # Filtrar datos para la enfermedad 'd' y ordenar por año\n","  df_d <- df_agg %>% filter(MORTALIDAD == d) %>% arrange(`AÑO`)\n","\n","  # Asegurar que la serie tenga todos los años (2013-2023), completando si es necesario\n","  all_years <- data.frame(`AÑO` = 2013:2023)\n","  df_d_complete <- merge(all_years, df_d, by = \"AÑO\", all.x = TRUE)\n","  # Imputar con 0 los años sin datos\n","  df_d_complete$Total_Pacientes[is.na(df_d_complete$Total_Pacientes)] <- 0\n","\n","  # Crear el objeto de serie de tiempo\n","  ts_d <- ts(df_d_complete$Total_Pacientes, start = 2013, frequency = 1)\n","\n","  # Verificar que la serie tenga al menos 2 observaciones\n","  if(length(ts_d) < 2) next\n","\n","  # Ajustar el modelo Holt–Winters sin tendencia ni estacionalidad (beta=FALSE, gamma=FALSE)\n","  model <- HoltWinters(ts_d, beta = FALSE, gamma = FALSE)\n","\n","  # Realizar el forecast para 1 período (2024)\n","  forecast_d <- forecast(model, h = 1)\n","  pred <- as.numeric(forecast_d$mean)\n","\n","  # Agregar la predicción al data frame de resultados\n","  results <- rbind(results, data.frame(Disease = d, Predicted2024 = pred, stringsAsFactors = FALSE))\n","}\n","\n","# Ordenar en forma descendente y obtener el top 10\n","results_top10 <- results %>% arrange(desc(Predicted2024)) %>% head(10)\n","kable(results_top10, caption = \"\")\n","\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"JjnvesUcS7mf","executionInfo":{"status":"ok","timestamp":1741385896069,"user_tz":300,"elapsed":5054,"user":{"displayName":"PEDRO LUIS PEREZ BARAHONA","userId":"16526492446743362157"}},"outputId":"49d777f8-d428-4c99-87f4-2aa7be6b59e0"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","\n","Table: \n","\n","|Disease                                                                            | Predicted2024|\n","|:----------------------------------------------------------------------------------|-------------:|\n","|Neumonía, no especificada                                                          |     54.999020|\n","|COVID-19, virus identificado.                                                     